# Set these in Vercel -> AnalystFemi project -> Settings -> Environment Variables (never commit real values).

# Same Bachs account as rcpt. sk_live_... = real money, sandbox keys = test mode.
BACHS_SECRET_KEY=
# Shown by Bachs when you add the webhook endpoint https://analystfemi.joshuaakintayo.me/api/webhook
BACHS_WEBHOOK_SECRET=

# Google Drive: a service account that is an Editor on both folders below.
# Paste the whole service-account JSON (or its base64).
GOOGLE_SERVICE_ACCOUNT_JSON=
# The folder id is the last part of the Drive folder URL: drive.google.com/drive/folders/<ID>
# Full = the "Student Content" folder. Excel Track = the "1 Excel Track" folder.
# NEVER use the root "Excel and PowerBI Course" folder: it holds Joshua's internal course-pack notes.
# A tier can list several ids separated by commas (e.g. Excel Track = the module 1-8 folders, so nothing is duplicated).
DRIVE_FOLDER_FULL=
DRIVE_FOLDER_EXCEL=

# Welcome email via Resend (same account rcpt used; the domain mail.joshuaakintayo.me is already verified).
RESEND_API_KEY=
# Optional. Defaults shown.
MAIL_FROM=AnalystFemi <hello@mail.joshuaakintayo.me>
MAIL_REPLY_TO=joshuaakintayo21@gmail.com
# Optional: the student WhatsApp group invite link, shown as a button in the email.
WHATSAPP_GROUP_LINK=

# Launch price stops after this date (YYYY-MM-DD). Keep in step with LAUNCH.endsOn in src/data/course.ts.
LAUNCH_ENDS_ON=
# Optional. Defaults to the site's own origin.
SITE_URL=https://analystfemi.joshuaakintayo.me
