      <div class="bento-card bento-glow grid items-center gap-8 p-6 sm:p-10 md:grid-cols-[auto_1fr]">
        <div class="flex h-28 w-28 shrink-0 flex-col items-center justify-center rounded-full border-2 border-accent text-center font-mono">
          <span class="text-3xl font-extrabold text-accent">30</span>
          <span class="text-[10px] uppercase tracking-wider text-accent font-semibold">DAY REFUND</span>
        </div>
        <div>
          <h3 class="text-2xl font-bold sm:text-3xl">Try Zero to Data Analyst For 30 Days.</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Enroll today. Open the course folder. Watch the lessons. Rebuild the datasets. If within your first 30 days you decide this program is not for you, simply send a message on WhatsApp or email.
          </p>
          <p class="mt-3 font-semibold text-sm text-accent">
            We will refund 100% of your payment. No long story.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 18. FAQ SECTION BENTO -->
  <section id="faq" class="scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
    <div class="mx-auto max-w-4xl">
      <div class="text-center">
        <p class="eyebrow">Frequently Asked Questions</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Everything You Need to Know Before Joining.
        </h2>
      </div>

      <div class="mt-12 space-y-3">
        {FAQS.map((f) => (
          <details class="bento-card group p-5 sm:p-6 transition-all">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-base sm:text-lg">
              <span>{f.q}</span>
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-line font-mono text-sm transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 19. FINAL CLOSE -->
  <section class="px-4 pb-24 sm:px-6">
    <div class="bento-card bento-dark bento-glow-dark relative mx-auto max-w-5xl overflow-hidden p-8 text-center shadow-2xl sm:p-14 lg:p-20">
      <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full border-[32px] border-accent/20" aria-hidden="true"></div>
      <h2 class="relative mx-auto max-w-3xl text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        You Can Keep Watching Other People Build Dashboards. Or Learn to <span class="text-[#2dd4bf]">Become the Analyst Behind Them</span>.
      </h2>
      <p class="relative mx-auto mt-4 max-w-xl text-base text-white/85">
        Companies are already paying for this work every single day. The only question is whether you are ready to learn the system and build the proof.
      </p>
      <div class="relative mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={buyFull}
          data-pay="full"
          data-pay-name={fullTier.name}
          data-pay-price={naira(fullNow)}
          class="btn-press rounded-full bg-accent px-8 py-4 text-base font-bold text-accent-fg shadow-lg shadow-accent/20 transition-all hover:brightness-105"
        >
          Join {COURSE.name} for {naira(fullNow)} →
        </a>
        <a href={freeLink} class="btn-press rounded-full border border-white/30 bg-white/5 px-6 py-4 text-sm font-medium text-white hover:bg-white/15">
          Get Free Starter Pack
        </a>
      </div>
    </div>
  </section>

  <!-- 20. FLOATING STICKY BOTTOM BAR -->
  <aside id="sticky-bar" class="fixed bottom-0 left-0 right-0 z-40 translate-y-full border-t border-line bg-bg/95 p-3 backdrop-blur-md transition-transform duration-300 sm:bottom-4 sm:left-1/2 sm:right-auto sm:-translate-x-1/2 sm:rounded-2xl sm:border sm:shadow-2xl sm:p-3 sm:w-[460px]">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="font-bold text-sm leading-tight">{COURSE.name}</p>
        <p class="font-mono text-xs text-accent font-semibold">{naira(fullNow)} · Founding Launch</p>
      </div>
      <a
        href={buyFull}
        data-pay="full"
        data-pay-name={fullTier.name}
        data-pay-price={naira(fullNow)}
        class="btn-press rounded-full bg-accent px-5 py-2.5 text-xs font-bold text-accent-fg shadow-md transition-opacity hover:opacity-90"
      >
        Enroll Now →
      </a>
    </div>
  </aside>

  <!-- Image Lightbox Dialog for Screenshots -->
  <dialog id="zoom-dialog" class="m-auto max-h-[92vh] max-w-[92vw] rounded-2xl border border-line bg-bg p-3 shadow-2xl backdrop:bg-black/75">
    <div class="relative flex flex-col items-center">
      <button id="zoom-close" type="button" class="btn-press absolute -top-2 -right-2 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-fg text-bg shadow-md">✕</button>
      <img id="zoom-img" src="" alt="" class="max-h-[85vh] w-auto rounded-xl object-contain" />
    </div>
  </dialog>

  <!-- Checkout / Lead capture Dialog -->
  <dialog id="pay-dialog" class="m-auto w-[min(92vw,26rem)] rounded-2xl border border-line bg-bg p-6 text-fg shadow-2xl backdrop:bg-black/50">
    <form id="pay-form" class="space-y-4">
      <div>
        <h2 id="pay-title" class="font-display text-2xl font-semibold">Enroll in {COURSE.name}</h2>
        <p id="pay-price" class="mt-1 font-mono text-sm text-accent"></p>
      </div>
      <label class="block text-sm font-medium">
        Google account email
        <input id="pay-email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@gmail.com" class="mt-1.5 block w-full rounded-xl border border-line bg-surface px-4 py-3 text-base font-normal" />
        <span class="mt-1 block text-xs font-normal text-muted">This email gets instant access to the course folder in Google Drive.</span>
      </label>
      <label class="block text-sm font-medium">
        Your name <span class="font-normal text-muted">(optional)</span>
        <input id="pay-name" name="name" type="text" autocomplete="name" class="mt-1.5 block w-full rounded-xl border border-line bg-surface px-4 py-3 text-base font-normal" />
      </label>
      <p id="pay-error" class="hidden text-sm text-red-500" role="alert"></p>
      <div class="flex gap-3">
        <button id="pay-submit" type="submit" class="btn-press flex-1 rounded-full bg-accent px-5 py-3 text-sm font-medium text-accent-fg transition-opacity hover:opacity-90 disabled:opacity-60">Continue to payment</button>
        <button id="pay-cancel" type="button" class="btn-press rounded-full border border-line px-5 py-3 text-sm font-medium">Cancel</button>
      </div>
    </form>
  </dialog>
</Layout>

<script>
  // Paid tier checkout trigger
  const dialog = document.getElementById("pay-dialog") as HTMLDialogElement | null;
  if (dialog) {
    const form = document.getElementById("pay-form") as HTMLFormElement;
    const title = document.getElementById("pay-title")!;
    const price = document.getElementById("pay-price")!;
    const email = document.getElementById("pay-email") as HTMLInputElement;
    const nameInput = document.getElementById("pay-name") as HTMLInputElement;
    const error = document.getElementById("pay-error")!;
    const submit = document.getElementById("pay-submit") as HTMLButtonElement;
    let tier = "";

    const showError = (msg: string) => {
      error.textContent = msg;
      error.classList.toggle("hidden", !msg);
    };

    document.querySelectorAll<HTMLAnchorElement>("[data-pay]").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        tier = a.dataset.pay ?? "full";
        title.textContent = a.dataset.payName ?? "Enroll in Zero to Data Analyst";
        price.textContent = a.dataset.payPrice ? `${a.dataset.payPrice} · one-time payment` : "";
        showError("");
        dialog.showModal();
        email.focus();
      });
    });
    document.getElementById("pay-cancel")?.addEventListener("click", () => dialog.close());

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      showError("");
      submit.disabled = true;
      submit.textContent = "One moment…";
      try {
        const res = await fetch("/api/checkout", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ tier, email: email.value, name: nameInput.value }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.url) {
          window.location.assign(data.url);
          return;
        }
        showError(data.error || (res.status === 404 ? "Checkout is not available on this preview. Message me on WhatsApp to pay." : "Could not start checkout. Please try again."));
      } catch {
        showError("Network problem. Check your connection and try again.");
      }
      submit.disabled = false;
      submit.textContent = "Continue to payment";
    });
  }

  // Tabs for BrightPark Showcase
  document.querySelectorAll<HTMLElement>(".af-tabs").forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((btn) => {
      btn.addEventListener("click", () => {
        root.querySelectorAll("[data-tab]").forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
        root.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => p.classList.toggle("hidden", p.dataset.panel !== btn.dataset.tab));
      });
    });
  });

  // Sticky Join Bar scroll reveal
  const stickyBar = document.getElementById("sticky-bar");
  if (stickyBar) {
    window.addEventListener("scroll", () => {
      if (window.scrollY > 600) {
        stickyBar.classList.remove("translate-y-full");
      } else {
        stickyBar.classList.add("translate-y-full");
      }
    });
  }

  // Screenshot Lightbox Modal
  const zoomDialog = document.getElementById("zoom-dialog") as HTMLDialogElement | null;
  const zoomImg = document.getElementById("zoom-img") as HTMLImageElement | null;
  const zoomClose = document.getElementById("zoom-close");

  if (zoomDialog && zoomImg) {
    document.querySelectorAll<HTMLButtonElement>("[data-zoom-src]").forEach((btn) => {
      btn.addEventListener("click", () => {
        zoomImg.src = btn.dataset.zoomSrc ?? "";
        zoomImg.alt = btn.dataset.zoomAlt ?? "";
        zoomDialog.showModal();
      });
    });
    zoomClose?.addEventListener("click", () => zoomDialog.close());
    zoomDialog.addEventListener("click", (e) => {
      if (e.target === zoomDialog) zoomDialog.close();
    });
  }
</script>
