---
import Layout from "@ja/ui/components/Layout.astro";
import Icon from "@ja/ui/components/Icon.astro";
import Logo from "@ja/ui/components/Logo.astro";
import { siteUrl, whatsappLink } from "@ja/ui/sites";
import HeroPlayer from "../remotion/HeroPlayer";
import {
  ANALYSIS_LOOP,
  CHECKOUT,
  COMPARISON,
  COURSE,
  FAQS,
  FOR_YOU,
  INCLUDED_STACK,
  LAUNCH,
  MARKET_SALARIES,
  NOT_FOR_YOU,
  PARTS,
  PRICE_COMPARISONS,
  PRICE_LADDER,
  ROLES_BRIDGE,
  TESTIMONIALS,
  TIERS,
  TIKTOK,
  TOOLS,
  YOUTUBE,
} from "../data/course";
import "../styles/global.css";

const naira = (n: number) => `₦${n.toLocaleString("en-NG")}`;
const launchPrice = (n: number) => Math.round(n * (1 - LAUNCH.percent / 100));

const buy = (id: "free" | "full", name: string) =>
  CHECKOUT[id] || whatsappLink(`Hi Joshua, I'd like to enroll in ${name} (${COURSE.name}).`);

const freeLink = buy("free", "Free Starter Pack");
const fullTier = TIERS.find((t) => t.id === "full")!;
const fullNow = LAUNCH.active ? launchPrice(fullTier.price) : fullTier.price;
const buyFull = buy("full", fullTier.name);
const hours = (m: number) => (m >= 60 ? `${(m / 60).toFixed(1).replace(".0", "")} h` : `${m} min`);

const showcase = [
  { id: "exec", label: "Executive summary", image: "/media/brightpark-executive.webp" },
  { id: "sales", label: "Sales performance", image: "/media/brightpark-sales.webp" },
  { id: "mkt", label: "Marketing", image: "/media/brightpark-marketing.webp" },
];
---

<Layout
  site="analystfemi"
  title={`${COURSE.name} · ${COURSE.tagline} by Joshua Akintayo`}
  description="Master Excel and Power BI with 11+ hours of real messy data classes, two capstone portfolio projects, and direct WhatsApp mentorship. Start free or join the founding launch."
  links={[
    { label: "Market Demand", href: "#demand" },
    { label: "The System", href: "#system" },
    { label: "Curriculum", href: "#curriculum" },
    { label: "Mentorship", href: "#mentorship" },
    { label: "Results", href: "#results" },
    { label: "Pricing", href: "#pricing" },
    { label: "FAQ", href: "#faq" },
    { label: "Blog", href: "/blog/" },
  ]}
>
  <a slot="cta" href={buyFull} data-pay="full" data-pay-name={fullTier.name} data-pay-price={naira(fullNow)} class="btn-press hidden rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-accent-fg transition-opacity hover:opacity-90 sm:inline-flex">
    Enroll for {naira(fullNow)}
  </a>

  <!-- 1. HERO SECTION -->
  <section class="relative overflow-hidden pt-6 pb-16 sm:pt-10 sm:pb-24">
    <div class="graph-paper pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
        <div>
          <!-- Main Headline (Pill badge removed as requested) -->
          <h1 class="text-[2.6rem] font-bold leading-[1.03] tracking-tight sm:text-5xl lg:text-[3.85rem]">
            Become the Data Analyst Behind <span class="accent-word">High-Stakes Business Decisions</span>.
          </h1>

          <!-- Subhead -->
          <p class="mt-6 text-lg leading-relaxed text-muted sm:text-xl">
            Get paid to take messy, corrupted spreadsheets, build executive Power BI dashboards, and guide million-naira business decisions — even if you have never worked in tech or written a single line of code before.
          </p>

          <!-- Primary CTA Bento Box -->
          <div class="bento-card bento-glow mt-8 p-5 sm:p-7">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="font-mono text-xs uppercase tracking-wider text-accent font-semibold flex items-center gap-2">
                <span class="pulse-dot"></span>
                Flagship Program · Excel + Power BI + Mentorship
              </span>
              <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-semibold text-accent">50% Off Launch</span>
            </div>

            <div class="mt-3 flex flex-wrap items-baseline gap-3 font-mono">
              <span class="text-4xl font-bold sm:text-5xl">{naira(fullNow)}</span>
              <span class="text-xl line-through text-muted">{naira(fullTier.price)}</span>
              <span class="text-xs text-muted">one-time payment · lifetime access</span>
            </div>

            <a
              href={buyFull}
              data-pay="full"
              data-pay-name={fullTier.name}
              data-pay-price={naira(fullNow)}
              class="btn-press mt-5 block w-full rounded-xl bg-accent px-6 py-4 text-center text-base font-semibold text-accent-fg shadow-lg shadow-accent/20 transition-all hover:brightness-105"
            >
              Enroll in {COURSE.name} for {naira(fullNow)} →
            </a>

            <div class="mt-4 flex flex-wrap items-center justify-between gap-2 text-xs text-muted">
              <span>✓ Instant Google Drive course access</span>
              <span>✓ AnalystFemi WhatsApp Data Club</span>
              <span>✓ 30-Day Money-Back Guarantee</span>
            </div>

            <div class="mt-4 border-t border-line pt-3 text-center text-sm">
              <a href={freeLink} class="font-medium text-accent underline underline-offset-4 hover:opacity-80">
                Not ready to pay yet? Download the Free Starter Pack with 4 lessons & dataset →
              </a>
            </div>
          </div>

          <!-- Micro Pills -->
          <div class="mt-6 flex flex-wrap gap-2 text-xs font-mono text-muted">
            <span class="rounded-lg border border-line bg-surface px-2.5 py-1">Messy Datasets</span>
            <span class="rounded-lg border border-line bg-surface px-2.5 py-1">Power Query Automation</span>
            <span class="rounded-lg border border-line bg-surface px-2.5 py-1">Star Schema DAX</span>
            <span class="rounded-lg border border-line bg-surface px-2.5 py-1">Executive UI Dashboards</span>
          </div>

          <!-- Teacher Attribution -->
          <a href="#instructor" class="mt-8 flex w-fit items-center gap-3 text-sm transition-opacity hover:opacity-85">
            <img src="/media/joshua-purple.webp" alt="Joshua Akintayo" width="48" height="48" class="h-12 w-12 rounded-full border border-line object-cover" />
            <div class="leading-tight">
              <span class="block font-semibold">Taught by Joshua Akintayo</span>
              <span class="text-xs text-muted">Data analyst & data engineer · {TIKTOK.handle}</span>
            </div>
          </a>
        </div>

        <!-- Hero Graphic with Mockup & Floating Motion Tags -->
        <div class="relative">
          <div class="relative rounded-[28px] border border-line bg-bg p-2.5 shadow-2xl shadow-black/10 transition-transform duration-300 hover:scale-[1.01]">
            <HeroPlayer client:visible />
          </div>

          <!-- Floating Tags with Natural Floating Motion -->
          <div class="hero-tag float-slow -top-4 -left-4 hidden md:inline-flex">
            <span>Messy Data Cleaned in Power Query</span>
          </div>
          <div class="hero-tag float-slow delay top-1/3 -right-6 hidden md:inline-flex">
            <span>DAX Year-over-Year KPIs</span>
          </div>
          <div class="hero-tag float-slow -bottom-4 left-6 hidden md:inline-flex">
            <span>Executive PowerPoint UI Canvas</span>
          </div>
        </div>
      </div>

      <!-- Objection Breakers: The Bento "You Do Not Need" Section -->
      <div class="mt-16 sm:mt-20">
        <p class="font-mono text-xs uppercase tracking-wider text-muted text-center sm:text-left">Eliminating the barriers</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <div class="bento-card p-5">
            <span class="flex h-7 w-7 items-center justify-center rounded-md border border-line font-mono text-sm text-muted">×</span>
            <p class="mt-3 text-[15px] font-medium leading-snug">You do not need a computer science or math degree.</p>
          </div>
          <div class="bento-card p-5">
            <span class="flex h-7 w-7 items-center justify-center rounded-md border border-line font-mono text-sm text-muted">×</span>
            <p class="mt-3 text-[15px] font-medium leading-snug">You do not need to write code in Python or SQL.</p>
          </div>
          <div class="bento-card p-5">
            <span class="flex h-7 w-7 items-center justify-center rounded-md border border-line font-mono text-sm text-muted">×</span>
            <p class="mt-3 text-[15px] font-medium leading-snug">You do not need prior tech industry experience.</p>
          </div>
          <div class="bento-card bento-dark bento-glow-dark p-5 shadow-lg">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-accent font-mono text-sm text-accent-fg font-bold">✓</span>
            <p class="mt-3 text-[15px] font-semibold leading-snug text-white">
              All you need is to learn how to <span class="text-[#2dd4bf]">think through the data</span> and solve business problems.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key facts banner -->
  <section class="border-y border-line bg-surface">
    <dl class="mx-auto grid max-w-6xl grid-cols-2 divide-line px-4 sm:px-6 lg:grid-cols-4 lg:divide-x">
      {[
        [COURSE.lessons, "recorded class lessons"],
        [COURSE.hours, "hours of real teaching"],
        [String(COURSE.capstones), "capstone portfolio builds"],
        ["Full", "WhatsApp mentorship layer"],
      ].map(([v, l]) => (
        <div class="py-6 lg:px-6 lg:first:pl-0">
          <dt class="font-mono text-2xl font-bold sm:text-3xl">{v}</dt>
          <dd class="text-sm text-muted">{l}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- 2. MARKET REALITY & BENTO SALARY PROOF (NAIRA ONLY) -->
  <section id="demand" class="scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="eyebrow">Real Market Demand in Nigeria</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
          Companies Are Desperately Looking For People Who Can Turn Messy Spreadsheets Into Profit. <span class="accent-word">Right Now</span>.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Not someday. Not in five years. Right now across Lagos, Abuja, and remote Nigerian businesses. Check real salary postings across Nigerian job boards:
        </p>
      </div>

      <!-- Real Salary Postings Bento Grid -->
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {MARKET_SALARIES.map((s, idx) => (
          <div class:list={["bento-card flex flex-col justify-between p-6", idx === 2 && "bento-glow border-accent/40"]}>
            <div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-[11px] text-muted uppercase tracking-wider">{s.type}</span>
                {idx === 2 && <span class="rounded bg-accent/20 px-2 py-0.5 font-mono text-[10px] text-accent font-semibold">High Value</span>}
              </div>
              <h3 class="mt-2 text-lg font-bold leading-tight">{s.role}</h3>
              <p class="mt-3 font-mono text-xl font-bold text-accent">{s.range}</p>
            </div>
            <p class="mt-4 border-t border-line pt-3 text-xs leading-relaxed text-muted">
              {s.duty}
            </p>
          </div>
        ))}
      </div>

      <!-- What Brands Are Actually Hiring You To Do: Bento Summary -->
      <div class="bento-card bento-glow mt-8 p-6 sm:p-8">
        <h3 class="text-xl font-semibold">And when you look at what employers are actually paying for, it is always the same core responsibilities:</h3>
        <p class="mt-3 text-muted leading-relaxed">
          Cleaning corrupted sales and transaction exports, fixing broken formulas, automating weekly reporting pipelines so nobody wastes 8 hours doing manual copy-pasting, calculating business growth KPIs, and designing executive dashboards that reveal where money is being lost.
        </p>
        <div class="mt-6 flex flex-wrap items-baseline gap-4 border-t border-line pt-5">
          <span class="font-mono text-3xl font-bold text-accent sm:text-4xl">₦150k – ₦750k+</span>
          <span class="text-sm text-muted">monthly earnings for analysts who know how to solve real business problems with Excel and Power BI.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. DEMYSTIFYING THE CRAFT: BENTO WORKFLOW LOOP -->
  <section id="system" class="scroll-mt-20 border-t border-line bg-surface px-4 py-20 sm:px-6 sm:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="eyebrow">The Real Work</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
          So What Exactly Does a <span class="accent-word">Data Analyst</span> Actually Do?
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Every growing business has the exact same problem: they are drowning in messy spreadsheets. Daily sales logs, warehouse receipts, customer registration lists, payment exports from Paystack, Flutterwave, or banking portals.
        </p>
      </div>

      <!-- The Contrast Bento: Tools vs Answers -->
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        <div class="bento-card p-5">
          <p class="font-mono text-xs uppercase tracking-wider text-muted">The Intern</p>
          <p class="mt-2 text-base font-medium">An intern can type SUM and copy formulas.</p>
        </div>
        <div class="bento-card p-5">
          <p class="font-mono text-xs uppercase tracking-wider text-muted">The AI Tool</p>
          <p class="mt-2 text-base font-medium">Even AI can now draw a quick bar chart in seconds.</p>
        </div>
        <div class="bento-card p-5">
          <p class="font-mono text-xs uppercase tracking-wider text-muted">The Template</p>
          <p class="mt-2 text-base font-medium">Anyone can download a colorful PowerPoint template.</p>
        </div>
      </div>

      <!-- The Big Executive Question Card -->
      <div class="bento-card bento-glow mt-8 p-6 sm:p-8">
        <p class="font-mono text-sm uppercase tracking-wider text-accent font-semibold">The Million-Naira Question</p>
        <h3 class="mt-2 text-2xl font-bold sm:text-3xl">
          "Why did our revenue drop 24% last month, and what should the CEO do on Monday?"
        </h3>
        <p class="mt-4 text-muted">And other critical business questions like:</p>
        <ul class="mt-3 grid gap-2.5 sm:grid-cols-2 text-sm">
          <li class="flex items-start gap-2"><span class="text-accent font-mono font-bold">?</span><span>Which products generate 80% of actual profit vs. just vanity volume?</span></li>
          <li class="flex items-start gap-2"><span class="text-accent font-mono font-bold">?</span><span>Which customer segments are churning right after their first purchase?</span></li>
          <li class="flex items-start gap-2"><span class="text-accent font-mono font-bold">?</span><span>Which sales reps or branches are consistently underperforming targets?</span></li>
          <li class="flex items-start gap-2"><span class="text-accent font-mono font-bold">?</span><span>What inventory should we reorder next week to avoid running out of stock?</span></li>
        </ul>
        <p class="mt-6 font-semibold text-lg">
          The person who answers these questions is the <span class="rounded bg-accent/20 px-2 py-0.5 text-accent">Data Analyst</span>.
        </p>
      </div>

      <!-- The 6-Step Visual Loop as an Interactive Bento Grid -->
      <div class="bento-card mt-8 p-6 sm:p-8">
        <div class="flex items-center justify-between border-b border-line pb-4">
          <p class="font-mono text-xs uppercase tracking-wider text-muted font-bold">The AnalystFemi 6-Step Pipeline</p>
          <span class="font-mono text-xs text-accent">↺ repeatable business intelligence loop</span>
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {ANALYSIS_LOOP.map((step) => (
            <div class="rounded-xl border border-line bg-surface/60 p-4 transition-transform hover:-translate-y-1">
              <span class="font-mono text-xs font-bold text-accent">{step.step}</span>
              <h4 class="mt-1 font-bold text-base">{step.label}</h4>
              <p class="mt-1 text-xs text-muted leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. THE CATCH & THE MARKET GAP (BENTO SPLIT) -->
  <section class="px-4 py-20 sm:px-6 sm:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="eyebrow">The Market Gap</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
          There Are Thousands of People Calling Themselves Data Analysts. <span class="accent-word">But Not Enough Good Ones.</span>
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          A lot of people think learning data analysis means watching a 5-minute tutorial on a clean, 20-row sample table, collecting a free PDF certificate, and putting "Data Analyst" in their LinkedIn bio.
        </p>
        <p class="mt-3 text-lg leading-relaxed text-muted">
          Then they get their first real business test or freelance dataset with 15,000 corrupted rows, mixed date formats, and null values — and they completely freeze.
        </p>
      </div>

      <!-- Comparison: Weak vs High-Value Analyst -->
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <div class="bento-card p-6 sm:p-8">
          <span class="font-mono text-xs uppercase tracking-wider text-muted">The Outdated Way</span>
          <h3 class="mt-2 text-2xl font-bold line-through opacity-70">The "Button Clicker"</h3>
          <ul class="mt-6 space-y-3.5 text-[15px] text-muted">
            <li class="flex items-start gap-2.5"><span class="font-mono text-muted">×</span><span>Only knows how to work with clean, pre-packaged tutorial data.</span></li>
            <li class="flex items-start gap-2.5"><span class="font-mono text-muted">×</span><span>Panics when formulas return #N/A or #VALUE! errors.</span></li>
            <li class="flex items-start gap-2.5"><span class="font-mono text-muted">×</span><span>Builds cluttered, neon pie charts that give managers headaches.</span></li>
            <li class="flex items-start gap-2.5"><span class="font-mono text-muted">×</span><span>Shows numbers without knowing what business decision they guide.</span></li>
            <li class="flex items-start gap-2.5"><span class="font-mono text-muted">×</span><span>Has a certificate but zero portfolio projects to show employers.</span></li>
          </ul>
        </div>

        <div class="bento-card bento-dark bento-glow-dark p-6 sm:p-8 shadow-xl">
          <span class="font-mono text-xs uppercase tracking-wider text-[#2dd4bf] font-bold">The AnalystFemi Standard</span>
          <h3 class="mt-2 text-2xl font-bold text-white">The High-Value Decision Partner</h3>
          <ul class="mt-6 space-y-3.5 text-[15px] text-white/90">
            <li class="flex items-start gap-2.5"><span class="font-mono text-[#2dd4bf] font-bold">✓</span><span>Confidently tames real-world dirty files using Power Query automation.</span></li>
            <li class="flex items-start gap-2.5"><span class="font-mono text-[#2dd4bf] font-bold">✓</span><span>Builds bulletproof Star Schema models and advanced DAX time-intelligence.</span></li>
            <li class="flex items-start gap-2.5"><span class="font-mono text-[#2dd4bf] font-bold">✓</span><span>Designs executive UI dashboards with custom backgrounds that tell a story.</span></li>
            <li class="flex items-start gap-2.5"><span class="font-mono text-[#2dd4bf] font-bold">✓</span><span>Translates raw numbers into plain English recommendations for leadership.</span></li>
            <li class="flex items-start gap-2.5"><span class="font-mono text-[#2dd4bf] font-bold">✓</span><span>Has 2 production-ready capstone portfolio projects ready on day one.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. THE BRIDGE: BENTO CARDS -->
  <section class="border-t border-line bg-surface px-4 py-20 sm:px-6 sm:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="eyebrow">Your Unfair Advantage</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
          And You May Already Be <span class="accent-word">Closer Than You Think</span>.
        </h2>
        <p class="mt-4 text-lg text-muted">
          You don't need to throw away your previous life to become a data analyst. Your past experience actually makes you faster:
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {ROLES_BRIDGE.map((r) => (
          <div class="bento-card p-6">
            <p class="text-sm text-muted">{r.who}</p>
            <p class="mt-1 text-xl font-bold text-accent">{r.has}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. THE SOLUTION REVEAL -->
  <section class="px-4 py-20 sm:px-6 sm:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="eyebrow">The Solution</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
          And That Is Why I Built <span class="accent-word">{COURSE.name}</span>.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Most data analytics courses stop at teaching you what formulas mean on clean data. But this program is structured around two indispensable pillars:
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="bento-card bento-glow p-6 sm:p-8">
          <span class="font-mono text-xs uppercase tracking-wider text-accent font-semibold">Pillar One</span>
          <h3 class="mt-2 text-2xl font-bold">Part 1: Build The System</h3>
          <p class="mt-3 text-muted leading-relaxed">
            14 modules of recorded classes cut from real sessions with students working on messy data. You watch the data get cleaned, formulas break, mistakes get fixed, and dashboards take shape. You get every practice workbook to build it yourself.
          </p>
        </div>

        <div class="bento-card bento-glow p-6 sm:p-8">
          <span class="font-mono text-xs uppercase tracking-wider text-accent font-semibold">Pillar Two</span>
          <h3 class="mt-2 text-2xl font-bold">Part 2: The AnalystFemi Mentorship</h3>
          <p class="mt-3 text-muted leading-relaxed">
            You don't learn in isolation. You join the AnalystFemi Data Club on WhatsApp with direct access to Joshua. You get personal dashboard teardowns, feedback on your DAX and layout, and guidance until your portfolio is job-ready.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. PART ONE: CURRICULUM BREAKDOWN -->
  <section id="curriculum" class="scroll-mt-20 border-t border-line bg-surface px-4 py-20 sm:px-6 sm:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Part One · Build The System</p>
          <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            The Complete <span class="accent-word">Curriculum</span>.
          </h2>
        </div>
        <p class="max-w-xs text-sm text-muted">
          {COURSE.modules} modules · {COURSE.hours} hours · Every practice file and dataset included.
        </p>
      </div>

      <!-- Curriculum Accordion Cards with Bento Styling -->
      <div class="mt-10 space-y-3">
