---
import Layout from "@ja/ui/components/Layout.astro";
import Icon from "@ja/ui/components/Icon.astro";
import Logo from "@ja/ui/components/Logo.astro";
import { siteUrl, whatsappLink } from "@ja/ui/sites";
import HeroPlayer from "../remotion/HeroPlayer";
import { FAQS, INCLUDED, PHASES, PROGRAM, TIKTOK, TOOLS, YOUTUBE } from "../data/mentorship";
import "../styles/global.css";

const naira = (n: number) => `₦${n.toLocaleString("en-NG")}`;
const reserve = whatsappLink(`Hi Joshua, I'd like to reserve a seat in the ${PROGRAM.name} mentorship.`);

const showcase = [
  { id: "exec", label: "Executive summary", image: "/media/brightpark-executive.webp" },
  { id: "sales", label: "Sales performance", image: "/media/brightpark-sales.webp" },
  { id: "mkt", label: "Marketing", image: "/media/brightpark-marketing.webp" },
];
---

<Layout
  site="analystfemi"
  title="AnalystFemi · Zero to Data Analyst mentorship"
  description="Learn data analysis live with AnalystFemi: a 12-week mentorship in Excel, SQL and Power BI on Google Meet, with real projects. ₦50,000 a month."
  links={[
    { label: "Curriculum", href: "#curriculum" },
    { label: "Student work", href: "#work" },
    { label: "Instructor", href: "#instructor" },
    { label: "Pricing", href: "#pricing" },
    { label: "Blog", href: "/blog/" },
  ]}
>
  <a slot="cta" href={reserve} class="hidden rounded-full bg-accent px-4 py-2 text-sm font-medium text-accent-fg transition-opacity hover:opacity-90 sm:inline-flex">
    Reserve a seat
  </a>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="graph-paper pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 pb-16 pt-12 sm:px-6 sm:pt-16 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-bg px-3 py-1.5 text-sm">
          <Icon name="video" class="h-4 w-4 text-accent" />
          12-week live mentorship · Google Meet
        </span>
        <h1 class="mt-6 text-[2.75rem] font-semibold leading-[0.98] sm:text-6xl lg:text-7xl">
          Go from zero to <span class="accent-word whitespace-nowrap">data analyst</span> in 12 weeks.
        </h1>
        <p class="mt-6 max-w-lg text-lg text-muted">
          Excel, PostgreSQL and Power BI, taught live, with four portfolio projects you can show employers.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={reserve} class="rounded-full bg-accent px-6 py-3 text-sm font-medium text-accent-fg transition-opacity hover:opacity-90">Reserve a seat</a>
          <a href="#curriculum" class="rounded-full border border-line bg-bg px-6 py-3 text-sm font-medium transition-colors hover:bg-surface">See the curriculum</a>
        </div>
        <a href="#instructor" class="mt-10 flex w-fit items-center gap-3 border-t border-line pt-6 text-sm">
          <img src="/media/joshua-purple.webp" alt="" width="44" height="44" class="h-11 w-11 rounded-full object-cover" />
          <span class="leading-tight"><span class="block font-medium">Taught by Joshua Akintayo</span><span class="text-muted">Data analyst & data engineer · {TIKTOK.handle}</span></span>
        </a>
      </div>

      <div class="relative">
        <div class="rounded-[28px] border border-line bg-bg p-2 shadow-2xl shadow-black/10">
          <HeroPlayer client:visible />
        </div>
        <span class="float-slow absolute -left-3 -top-3 hidden rounded-full border border-line bg-bg px-3 py-1.5 font-mono text-xs shadow-lg sm:inline-flex">Real dashboard · built in my Power BI class</span>
        <span class="float-slow delay absolute -bottom-5 right-8 hidden items-center gap-2 rounded-full border border-line bg-white px-3 py-2 shadow-lg sm:inline-flex">
          <Logo name="excel" class="h-5 w-auto" /><span class="text-xs text-neutral-400">→</span><Logo name="postgresql" class="h-5 w-auto" /><span class="text-xs text-neutral-400">→</span><Logo name="powerbi" class="h-5 w-auto" />
        </span>
      </div>
    </div>
  </section>

  <!-- Key facts strip -->
  <section class="border-y border-line bg-surface">
    <dl class="mx-auto grid max-w-6xl grid-cols-2 divide-line px-4 sm:px-6 lg:grid-cols-4 lg:divide-x">
      {[
        [naira(PROGRAM.pricePerMonth), "per month · 3 months"],
        ["3×", "live sessions a week, 2 hrs"],
        ["4", "portfolio projects"],
        ["0", "experience needed"],
      ].map(([v, l]) => (
        <div class="py-6 lg:px-6 lg:first:pl-0">
          <dt class="font-mono text-2xl font-medium sm:text-3xl">{v}</dt>
          <dd class="text-sm text-muted">{l}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Tools -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <p class="eyebrow">The tech stack</p>
    <h2 class="mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl">Three tools <span class="accent-word">employers</span> ask for.</h2>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {TOOLS.map((t, i) => (
        <article data-reveal style={`--reveal-delay:${i * 80}ms`} class="flex items-start gap-4 rounded-[var(--radius-card)] border border-line p-5">
          <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl border border-line bg-white p-2.5"><Logo name={t.logo} class="h-8 w-auto" /></span>
          <div>
            <h3 class="text-xl font-semibold">{t.name}</h3>
            <p class="mt-1 text-[15px] text-muted">{t.learn}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Curriculum -->
  <section id="curriculum" class="scroll-mt-20 border-t border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <p class="eyebrow">Curriculum</p>
      <h2 class="mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl">From your first formula to your <span class="accent-word">first job</span>.</h2>

      <!-- Progress rail -->
      <div class="mt-10 hidden grid-cols-12 gap-1 md:grid" aria-hidden="true">
        {Array.from({ length: 12 }, (_, i) => (
          <div class="h-2 rounded-full" style={`background:color-mix(in oklab, var(--accent) ${25 + Math.floor(i / 4) * 30}%, transparent)`}></div>
        ))}
      </div>

      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {PHASES.map((m, i) => (
          <article data-reveal style={`--reveal-delay:${i * 100}ms`} class="flex flex-col rounded-[var(--radius-card)] border border-line bg-bg p-6">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs uppercase tracking-wider text-muted">{m.phase}</span>
              <span class="rounded-full bg-accent px-2.5 py-0.5 font-mono text-xs text-accent-fg">{m.tool}</span>
            </div>
            <h3 class="mt-3 text-xl font-semibold">{m.title}</h3>
            <ul class="mt-4 space-y-2.5">
              {m.modules.map((t) => (
                <li class="flex items-center gap-2.5">
                  <Icon name="check" class="h-4 w-4 shrink-0 text-accent" />
                  <span>{t}</span>
                </li>
              ))}
            </ul>
            <p class="mt-auto pt-6"><span class="inline-flex rounded-xl bg-accent-soft px-3 py-2 text-sm font-medium">{m.project}</span></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Student work -->
  <section id="work" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-24">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">Built in class</p>
        <h2 class="mt-4 text-4xl font-semibold sm:text-5xl">Real dashboards, built <span class="accent-word">with students</span>.</h2>
      </div>
      <p class="max-w-xs text-sm text-muted">Portfolio projects from my Power BI class.</p>
    </div>

    <!-- BrightPark: three-page report with tabs -->
    <div data-reveal class="af-tabs mt-10 overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-4 py-3">
        <p class="font-display font-semibold">BrightPark sales report <span class="font-sans text-sm font-normal text-muted">· 3 pages</span></p>
        <div class="flex gap-1.5" role="tablist">
          {showcase.map((s, i) => (
            <button type="button" role="tab" data-tab={s.id} aria-selected={i === 0 ? "true" : "false"} class="rounded-full border border-line px-3 py-1 text-xs aria-selected:border-accent aria-selected:bg-accent aria-selected:text-accent-fg">
              {s.label}
            </button>
          ))}
        </div>
      </div>
      <div class="bg-bg p-3 sm:p-5">
        {showcase.map((s, i) => (
          <img src={s.image} alt={`BrightPark Power BI report: ${s.label}`} data-panel={s.id} loading="lazy" class:list={["w-full rounded-xl", i !== 0 && "hidden"]} />
        ))}
      </div>
    </div>

    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <figure data-reveal class="overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
        <img src="/media/weather-dashboard.webp" alt="Weather dashboard for Abuja, Ibadan and Kano built in Power BI" loading="lazy" class="w-full" />
        <figcaption class="flex items-center justify-between px-4 py-3 text-sm"><span class="font-medium">Weather dashboard</span><span class="text-muted">Live API data · Abuja, Ibadan, Kano</span></figcaption>
      </figure>
      <figure data-reveal style="--reveal-delay:100ms" class="overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
        <video data-src="/media/sales-calendar.mp4" poster="/media/sales-calendar.webp" muted loop playsinline preload="none" aria-label="Interactive sales calendar with tooltips" class="w-full"></video>
        <figcaption class="flex items-center justify-between px-4 py-3 text-sm"><span class="font-medium">Sales performance calendar</span><span class="text-muted">Interactive tooltips</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- Watch me teach -->
  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Watch me teach</p>
          <h2 class="mt-4 text-4xl font-semibold sm:text-5xl">See how I <span class="accent-word">explain</span> it.</h2>
        </div>
        <p class="max-w-sm text-muted">Two full lessons from my TikTok. Every class is this hands-on, step by step, with real data.</p>
      </div>
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {[
          { src: "/media/power-query.mp4", poster: "/media/power-query.webp", title: "Data cleaning with Power Query", meta: "Power BI · 5 min", logo: "powerbi" },
          { src: "/media/vlookup-vs-xlookup.mp4", poster: "/media/vlookup-vs-xlookup.webp", title: "VLOOKUP vs XLOOKUP", meta: "Excel · 3 min", logo: "excel" },
        ].map((v, i) => (
          <figure data-reveal style={`--reveal-delay:${i * 100}ms`} class="overflow-hidden rounded-[var(--radius-card)] border border-line bg-bg">
            <video src={v.src} poster={v.poster} controls preload="none" playsinline aria-label={`Lesson: ${v.title}`} class="aspect-video w-full bg-black"></video>
            <figcaption class="flex items-center gap-3 px-5 py-4">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-line bg-white p-1.5"><Logo name={v.logo} class="h-5 w-auto" /></span>
              <span class="leading-tight"><span class="block font-medium">{v.title}</span><span class="text-sm text-muted">{v.meta}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- What's included + instructor -->
  <section id="instructor" class="mx-auto grid max-w-6xl scroll-mt-20 gap-6 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <p class="eyebrow">What's included</p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {INCLUDED.map((it, i) => (
          <div data-reveal style={`--reveal-delay:${i * 80}ms`} class="rounded-2xl border border-line p-5">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-accent-soft text-accent"><Icon name={it.icon} /></span>
            <p class="mt-3 font-display text-lg font-semibold leading-tight">{it.title}</p>
            <p class="mt-1 text-sm text-muted">{it.note}</p>
          </div>
        ))}
      </div>
    </div>

    <article data-reveal class="relative flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
      <img src="/media/joshua-purple.webp" alt="Joshua Akintayo" width="720" height="720" loading="lazy" class="aspect-[4/3] w-full object-cover object-top" />
      <div class="p-6">
        <p class="eyebrow">Your instructor</p>
        <h3 class="mt-2 text-2xl font-semibold">Joshua Akintayo</h3>
        <p class="mt-2 text-[15px] text-muted">
          Data analyst and data engineer. Former data analyst at The ICIR, Microsoft Certified Fabric Analytics Engineer, and founder of InsightsHub.
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-sm">
          <a href={TIKTOK.url} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line px-3 py-1.5 hover:border-accent">TikTok {TIKTOK.handle} · {TIKTOK.followers}</a>
          <a href={YOUTUBE} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line px-3 py-1.5 hover:border-accent">YouTube</a>
          <a href={siteUrl("hub")} class="rounded-full border border-line px-3 py-1.5 hover:border-accent">Full story →</a>
        </div>
      </div>
    </article>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="scroll-mt-20 px-4 sm:px-6">
    <div data-reveal class="relative mx-auto grid max-w-6xl gap-8 overflow-hidden rounded-[32px] bg-accent px-6 py-12 text-accent-fg sm:px-12 lg:grid-cols-[1.3fr_1fr] lg:items-center">
      <div class="pointer-events-none absolute -right-12 -top-12 h-56 w-56 rounded-full border-[28px] border-accent-fg/10" aria-hidden="true"></div>
      <div class="relative">
        <p class="font-mono text-xs uppercase tracking-wider">Invest in your future</p>
        <p class="mt-3 font-mono text-5xl font-medium sm:text-6xl">{naira(PROGRAM.pricePerMonth)}<span class="text-2xl opacity-70"> / month</span></p>
        <p class="mt-2">3-month program · {PROGRAM.sessions} · {PROGRAM.platform}</p>
      </div>
      <div class="relative flex flex-col gap-3">
        <a href={reserve} class="rounded-full bg-accent-fg px-6 py-3 text-center text-sm font-medium text-accent">Reserve your seat on WhatsApp</a>
        <p class="text-center text-sm">Beginner friendly · Practical · Career-focused</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="mx-auto grid max-w-6xl scroll-mt-20 gap-10 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <p class="eyebrow">FAQ</p>
      <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Before you join.</h2>
      <p class="mt-5 text-muted">Need data work for your business instead of a class? <a href={siteUrl("hub", "/#services")} class="font-medium text-accent underline underline-offset-4">See my services</a>.</p>
    </div>
    <div class="divide-y divide-line border-y border-line">
      {FAQS.map((f) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
            {f.q}
            <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-line transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-2 text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <a href={reserve} class="fixed bottom-5 right-5 z-40 inline-flex rounded-full bg-accent px-5 py-3 text-sm font-medium text-accent-fg shadow-lg sm:hidden">
    Reserve a seat
  </a>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>(".af-tabs").forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((btn) => {
      btn.addEventListener("click", () => {
        root.querySelectorAll("[data-tab]").forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
        root.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => p.classList.toggle("hidden", p.dataset.panel !== btn.dataset.tab));
      });
    });
  });
</script>
