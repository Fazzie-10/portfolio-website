---
import Layout from "@ja/ui/components/Layout.astro";
import Icon from "@ja/ui/components/Icon.astro";
import Logo from "@ja/ui/components/Logo.astro";
import { siteUrl, whatsappLink } from "@ja/ui/sites";
import WorkflowPlayer from "../remotion/WorkflowPlayer";
import { PROCESS, SMALL_BUILDS, SNIPPY, SOCIALS, STACK, VENDORIQ } from "../data/builds";
import "../styles/global.css";

const hello = whatsappLink("Hi Joshua, I saw your automation work and I'd like to talk about a build.");
---

<Layout
  site="automation"
  defaultTheme="dark"
  title="Joshua Akintayo · AI tools & automation"
  description="Joshua Akintayo builds AI tools and automations that take repetitive work off your plate: WhatsApp assistants, transcription tools and video pipelines."
  links={[
    { label: "Builds", href: "#builds" },
    { label: "How I work", href: "#process" },
    { label: "Contact", href: "#contact" },
  ]}
>
  <a slot="cta" href={hello} class="hidden rounded-full bg-accent px-4 py-2 text-sm font-medium text-accent-fg transition-opacity hover:opacity-90 sm:inline-flex">
    Discuss a build
  </a>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      style="background-image: radial-gradient(color-mix(in oklab, var(--fg) 12%, transparent) 1px, transparent 1px); background-size: 26px 26px; mask-image: radial-gradient(ellipse 70% 60% at 60% 40%, #000 30%, transparent 100%);"
      aria-hidden="true"
    ></div>
    <div class="pointer-events-none absolute -right-40 top-10 h-[480px] w-[480px] rounded-full opacity-25 blur-3xl" style="background: var(--accent)" aria-hidden="true"></div>

    <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 pb-20 pt-12 sm:px-6 sm:pt-16 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-bg px-3 py-1.5 text-sm">
          <span class="h-2 w-2 animate-pulse rounded-full bg-accent"></span>
          AI tools & automation
        </span>
        <h1 class="mt-6 text-[2.75rem] font-semibold leading-[0.98] sm:text-6xl lg:text-7xl">
          I build AI tools that do the <span class="accent-word">boring</span> work.
        </h1>
        <p class="mt-6 max-w-lg text-lg text-muted">
          WhatsApp assistants, transcription tools and video pipelines that take repetitive work off your plate.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={hello} class="rounded-full bg-accent px-6 py-3 text-sm font-medium text-accent-fg transition-opacity hover:opacity-90">Discuss a build</a>
          <a href="#builds" class="rounded-full border border-line bg-bg px-6 py-3 text-sm font-medium transition-colors hover:bg-surface">See the builds</a>
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-4 border-t border-line pt-6 text-sm">
          <a href={siteUrl("hub")} class="flex items-center gap-3">
            <img src="/media/joshua-cutout.webp" alt="" width="40" height="50" class="h-10 w-10 rounded-full border border-line bg-accent-soft object-cover object-top" />
            <span class="leading-tight"><span class="block font-medium">Joshua Akintayo</span><span class="text-muted">Data engineer & builder</span></span>
          </a>
          <span class="hidden h-8 w-px bg-line sm:block"></span>
          <span class="whitespace-nowrap text-muted">
            I post builds as
            <a href={SOCIALS.tiktok} target="_blank" rel="noopener noreferrer" class="inline-block py-2 font-mono text-accent hover:underline">@femi_codes</a>
          </span>
        </div>
      </div>

      <!-- Phone with the real VendorIQ chat -->
      <div class="relative mx-auto w-[260px] sm:w-[290px]">
        <div class="rounded-[44px] border border-line bg-fg/90 p-2.5 shadow-2xl shadow-black/40">
          <div class="overflow-hidden rounded-[36px] bg-black">
            <!-- Drawn header: the recording's own header is cropped out so other chats' notifications never show -->
            <div class="flex items-center gap-2.5 bg-[#1f1f1f] px-4 pb-2.5 pt-5 text-white" aria-hidden="true">
              <span class="text-lg leading-none opacity-80">‹</span>
              <span class="grid h-8 w-8 place-items-center overflow-hidden rounded-full bg-white">
                <img src="/media/vendoriq-logo.webp" alt="" class="h-full max-w-none object-cover object-left" style="width:118px" />
              </span>
              <span class="leading-tight">
                <span class="block text-sm font-semibold">VendorIQ</span>
                <span class="block text-[10px] text-white/60">online</span>
              </span>
            </div>
            <video
              src="/media/vendoriq-chat.mp4"
              poster="/media/vendoriq-chat.webp"
              autoplay
              muted
              loop
              playsinline
              aria-label="VendorIQ on WhatsApp logging sales and answering questions"
              class="aspect-[540/963] w-full object-cover object-top"
            ></video>
          </div>
        </div>
        <span class="float-slow absolute -left-16 top-16 hidden rounded-full border border-line bg-bg px-3 py-1.5 font-mono text-xs shadow-lg sm:inline-flex">Voice notes ✓</span>
        <span class="float-slow delay absolute -right-14 top-1/2 hidden rounded-full bg-accent px-3 py-1.5 font-mono text-xs text-accent-fg shadow-lg sm:inline-flex">Gemini</span>
        <span class="float-slow absolute -left-10 bottom-16 hidden rounded-full border border-line bg-bg px-3 py-1.5 font-mono text-xs shadow-lg sm:inline-flex">FastAPI + Supabase</span>
      </div>
    </div>
  </section>

  <!-- Stack marquee -->
  <section class="overflow-hidden border-y border-line bg-surface py-5" aria-label="Tools I build with">
    <div class="ja-marquee flex w-max gap-3">
      {[...STACK, ...STACK].map((t) => (
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-bg px-4 py-2 font-mono text-sm">
          {t.logo && <Logo name={t.logo} class={t.logo === "gemini" ? "h-4 w-auto" : "h-5 w-auto"} />}
          {t.logo !== "gemini" && t.name}
        </span>
      ))}
    </div>
  </section>

  <!-- Builds -->
  <section id="builds" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
    <p class="eyebrow">Builds</p>
    <h2 class="mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl">Real problems, <span class="accent-word">working</span> tools.</h2>

    <!-- VendorIQ -->
    <article data-reveal class="mt-12 grid overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface lg:grid-cols-[1fr_1.15fr]">
      <div class="flex flex-col gap-5 p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <img src="/media/vendoriq-logo.webp" alt="VendorIQ" width="600" height="152" class="h-9 w-auto rounded-md bg-white px-2 py-1" />
          <span class="rounded-full border border-line px-3 py-1 font-mono text-[11px]">{VENDORIQ.status}</span>
        </div>
        <div>
          <p class="eyebrow">The problem</p>
          <p class="mt-1.5">{VENDORIQ.problem}</p>
        </div>
        <div>
          <p class="eyebrow">What I built</p>
          <p class="mt-1.5">{VENDORIQ.built}</p>
        </div>
        <ul class="mt-auto flex flex-wrap gap-2">
          {VENDORIQ.stack.map((s) => <li class="rounded-full bg-accent-soft px-3 py-1 font-mono text-xs">{s}</li>)}
        </ul>
      </div>
      <div class="relative bg-bg p-4 sm:p-6">
        <div class="overflow-hidden rounded-2xl border border-line">
          <div class="flex items-center gap-1.5 border-b border-line bg-surface px-3 py-2" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-line"></span><span class="h-2.5 w-2.5 rounded-full bg-line"></span><span class="h-2.5 w-2.5 rounded-full bg-line"></span>
            <span class="ml-3 font-mono text-[11px] text-muted">vendoriq landing page</span>
          </div>
          <video data-src="/media/vendoriq-site.mp4" poster="/media/vendoriq-site.webp" muted loop playsinline preload="none" aria-label="VendorIQ landing page" class="w-full"></video>
        </div>
      </div>
    </article>

    <!-- Snippy -->
    <article data-reveal class="mt-5 grid overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface lg:grid-cols-[1.15fr_1fr]">
      <div class="order-2 bg-bg p-4 sm:p-6 lg:order-1">
        <video
          src="/media/snippy-demo.mp4"
          poster="/media/snippy-demo.webp"
          controls
          preload="none"
          playsinline
          aria-label="Snippy demo: paste a YouTube link, pick clips, render"
          class="w-full rounded-2xl border border-line"
        ></video>
        <p class="mt-2 text-center text-xs text-muted">▶ Play the walkthrough (with sound)</p>
      </div>
      <div class="order-1 flex flex-col gap-5 p-6 sm:p-8 lg:order-2">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="text-3xl font-semibold">{SNIPPY.name}</h3>
          <span class="rounded-full border border-line px-3 py-1 font-mono text-[11px]">{SNIPPY.status}</span>
        </div>
        <div>
          <p class="eyebrow">The problem</p>
          <p class="mt-1.5">{SNIPPY.problem}</p>
        </div>
        <ol class="grid grid-cols-2 gap-2 text-sm">
          {["Paste a link", "Transcribe", "Pick clips", "Render 9:16"].map((s, i) => (
            <li class="flex items-center gap-2 rounded-xl border border-line bg-bg px-3 py-2">
              <span class="font-mono text-xs text-accent">0{i + 1}</span>{s}
            </li>
          ))}
        </ol>
        <ul class="mt-auto flex flex-wrap gap-2">
          {SNIPPY.stack.map((s) => <li class="rounded-full bg-accent-soft px-3 py-1 font-mono text-xs">{s}</li>)}
        </ul>
      </div>
    </article>

    <!-- Smaller builds -->
    <div class="mt-5 grid gap-5 md:grid-cols-3">
      {SMALL_BUILDS.map((b, i) => (
        <article data-reveal style={`--reveal-delay:${i * 100}ms`} class="flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
          <div class="relative flex h-72 items-center justify-center overflow-hidden bg-bg" aria-hidden="true">
            {b.name === "AF Studio" && (
              <video data-src="/media/afstudio-output.mp4" poster="/media/afstudio-output.webp" muted loop playsinline preload="none" class="h-full w-auto object-cover" />
            )}
            {b.name === "SpeechMate" && (
              <video data-src="/media/speechmate-demo.mp4" poster="/media/speechmate-demo.webp" muted loop playsinline preload="none" class="h-full w-auto object-cover" />
            )}
            {b.name === "PaletteIQ" && (
              <video data-src="/media/paletteiq-demo.mp4" poster="/media/paletteiq-demo.webp" muted loop playsinline preload="none" class="h-full w-full object-cover object-top" />
            )}
          </div>
          <div class="flex flex-1 flex-col gap-3 p-6">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-xl font-semibold">{b.name}</h3>
              <span class="rounded-full border border-line px-2.5 py-0.5 font-mono text-[10px]">{b.status}</span>
            </div>
            <p class="text-[15px] text-muted">{b.body}</p>
            <ul class="flex flex-wrap gap-1.5">
              {b.stack.map((s) => <li class="rounded-full bg-accent-soft px-2.5 py-0.5 font-mono text-[11px]">{s}</li>)}
            </ul>
            {b.href && (
              <a href={b.href} target="_blank" rel="noopener noreferrer" class="mt-auto inline-flex items-center gap-1.5 pt-2 text-sm font-medium text-accent hover:underline">
                Try it live <Icon name="arrow" class="h-4 w-4" />
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- How I work -->
  <section id="process" class="scroll-mt-20 border-t border-line bg-surface">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-2">
      <div>
        <p class="eyebrow">How I work</p>
        <h2 class="mt-4 text-4xl font-semibold sm:text-5xl">From messy task to <span class="accent-word">autopilot</span>.</h2>
        <ol class="mt-10 space-y-3">
          {PROCESS.map((p, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`} class="flex gap-4 rounded-2xl border border-line bg-bg p-4">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-accent font-mono text-xs text-accent-fg">0{i + 1}</span>
              <div>
                <p class="font-display text-lg font-semibold">{p.title}</p>
                <p class="text-[15px] text-muted">{p.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="mx-auto w-full max-w-md rounded-[28px] border border-line bg-bg p-2 lg:max-w-none">
        <WorkflowPlayer client:visible />
      </div>
    </div>
  </section>

  <!-- AI-assisted coding -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div data-reveal class="grid items-center gap-8 rounded-[var(--radius-card)] border border-line p-6 sm:p-10 md:grid-cols-[auto_1fr]">
      <span class="grid h-16 w-16 place-items-center rounded-2xl bg-accent text-accent-fg"><Icon name="sparkle" class="h-8 w-8" /></span>
      <div>
        <h2 class="text-2xl font-semibold sm:text-3xl">Built with AI-assisted coding, <span class="accent-word">owned</span> by me.</h2>
        <p class="mt-3 max-w-3xl text-muted">
          I build with AI coding agents like Claude Code and OpenCode, so a working prototype takes days, not months.
          I still design the system, test it, and debug it in production myself.
        </p>
      </div>
    </div>
  </section>

  <!-- Follow + contact -->
  <section id="contact" class="scroll-mt-20 px-4 pb-20 sm:px-6">
    <div class="relative mx-auto grid max-w-6xl gap-8 overflow-hidden rounded-[32px] bg-accent px-6 py-14 text-accent-fg sm:px-12 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <div class="pointer-events-none absolute -right-10 -top-10 h-56 w-56 rounded-full border-[28px] border-accent-fg/10" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="text-3xl font-semibold text-accent-fg sm:text-5xl">Got a task you repeat every week?</h2>
        <p class="mt-4 max-w-md">Tell me about it on WhatsApp. If it can be automated, I'll show you how.</p>
        <a href={hello} class="mt-8 inline-flex rounded-full bg-accent-fg px-6 py-3 text-sm font-medium text-accent">Chat on WhatsApp</a>
      </div>
      <div class="relative grid gap-3">
        <p class="font-mono text-xs uppercase tracking-wider">Follow the builds</p>
        <a href={SOCIALS.tiktok} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-2xl bg-accent-fg/10 px-5 py-4 transition-colors hover:bg-accent-fg/20">
          <span class="flex items-center gap-3">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.5.02c1.3-.02 2.6-.01 3.9-.02.1 1.5.6 3.1 1.8 4.2 1.1 1.1 2.7 1.6 4.2 1.8v4c-1.4-.2-2.9-.6-4.1-1.5l-.4-.3v5.5c0 1.9-.4 3.8-1.6 5.2-1.6 2-4.4 2.9-6.9 2.1-2.5-.7-4.4-3-4.6-5.5-.3-2.9 1.3-5.8 4-6.9.5-.2 1-.4 1.5-.4v4c-.3.1-.6.2-1 .3-1.1.5-1.8 1.6-1.8 2.8.1 1.1.8 2.2 1.9 2.5 1.1.3 2.4 0 3.1-.9.4-.5.6-1.2.6-1.9V0z"/></svg>
            TikTok
          </span>
          <span class="font-mono text-sm">@femi_codes</span>
        </a>
        <a href={SOCIALS.instagram} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-2xl bg-accent-fg/10 px-5 py-4 transition-colors hover:bg-accent-fg/20">
          <span class="flex items-center gap-3">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/></svg>
            Instagram
          </span>
          <span class="font-mono text-sm">@femi_codes</span>
        </a>
      </div>
    </div>
  </section>

  <a href={hello} class="fixed bottom-5 right-5 z-40 inline-flex rounded-full bg-accent px-5 py-3 text-sm font-medium text-accent-fg shadow-lg sm:hidden">
    WhatsApp me
  </a>
</Layout>

<style>
  .ja-marquee {
    animation: ja-scroll 40s linear infinite;
  }
  .ja-marquee:hover {
    animation-play-state: paused;
  }
  @keyframes ja-scroll {
    to { transform: translateX(-50%); }
  }
</style>
