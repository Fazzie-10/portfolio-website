---
import { render } from "astro:content";
import PostLayout from "@ja/ui/components/blog/PostLayout.astro";
import { whatsappLink } from "@ja/ui/sites";
import { getPosts } from "../../data/blog";
import "../../styles/global.css";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      // Related: posts sharing a tag first, then the newest others
      related: posts
        .filter((p) => p.id !== post.id)
        .sort((a, b) => Number(b.data.tags.some((t) => post.data.tags.includes(t))) - Number(a.data.tags.some((t) => post.data.tags.includes(t))))
        .slice(0, 3),
    },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
---

<PostLayout site="insightshub" data={post.data} body={post.body} related={related} links={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog/" }]}>
  <a slot="cta" href={whatsappLink("Hi Joshua, I read the InsightsHub blog and I need help with my analysis.")} class="hidden rounded-full bg-accent px-4 py-2 text-sm font-medium text-accent-fg sm:inline-flex">WhatsApp me</a>
  <Content />
</PostLayout>
