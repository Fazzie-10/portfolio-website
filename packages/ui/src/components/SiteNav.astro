---
import { SITES, type SiteId } from "../sites";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  site: SiteId;
  links?: { label: string; href: string }[];
}

const { site, links = [] } = Astro.props;
const current = SITES.find((s) => s.id === site)!;
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/80 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2 font-display text-[15px] font-semibold tracking-tight">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-accent font-mono text-[11px] font-medium text-accent-fg">JA</span>
        <span>{current.name}</span>
      </a>
    </div>

    <div class="flex items-center gap-1 sm:gap-6">
      <ul class="hidden items-center gap-6 text-sm text-muted md:flex">
        {links.map((l) => (
          <li><a href={l.href} class="transition-colors hover:text-fg">{l.label}</a></li>
        ))}
      </ul>
      <ThemeToggle />
      <slot name="cta" />
    </div>
  </nav>
</header>
