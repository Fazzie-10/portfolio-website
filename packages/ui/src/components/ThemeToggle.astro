---
// Cycles system → light → dark. Stored in a cookie on the parent domain.
---

<button
  type="button"
  class="ja-theme-toggle inline-flex h-10 w-10 items-center justify-center rounded-full border border-line text-fg transition-colors hover:bg-surface"
  aria-label="Change colour theme"
  title="Theme"
>
  <svg class="icon-system h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
  <svg class="icon-light h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="icon-dark h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
</button>

<style>
  .ja-theme-toggle svg { display: none; }
  :global(html[data-theme-pref="system"]) .ja-theme-toggle .icon-system,
  :global(html[data-theme-pref="light"]) .ja-theme-toggle .icon-light,
  :global(html[data-theme-pref="dark"]) .ja-theme-toggle .icon-dark { display: block; }
</style>

<script>
  const ORDER = ["system", "light", "dark"] as const;
  type Pref = (typeof ORDER)[number];
  const media = matchMedia("(prefers-color-scheme: dark)");

  function apply(pref: Pref) {
    const root = document.documentElement;
    const dark = pref === "dark" || (pref === "system" && media.matches);
    root.dataset.theme = dark ? "dark" : "light";
    root.dataset.themePref = pref;
  }

  function save(pref: Pref) {
    const host = location.hostname;
    const domain = host.endsWith("joshuaakintayo.me") ? "; domain=.joshuaakintayo.me" : "";
    document.cookie = `ja-theme=${pref}; path=/; max-age=31536000; SameSite=Lax${domain}`;
  }

  document.querySelectorAll<HTMLButtonElement>(".ja-theme-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const current = (document.documentElement.dataset.themePref as Pref) || "system";
      const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
      save(next);
      apply(next);
      btn.setAttribute("aria-label", `Theme: ${next}. Click to change.`);
    });
  });

  media.addEventListener("change", () => {
    if (document.documentElement.dataset.themePref === "system") apply("system");
  });
</script>
