---
import Layout from "../Layout.astro";
import PostCard from "./PostCard.astro";
import type { SiteId } from "../../sites";
import { readingMinutes } from "../../blog/schema";

interface Post {
  id: string;
  body?: string;
  data: { title: string; description: string; pubDate: Date; tags: string[]; cover?: string; coverAlt?: string };
}

interface Props {
  site: SiteId;
  posts: Post[];
  title: string;
  heading: string;
  accent: string;
  intro: string;
  description: string;
  links?: { label: string; href: string }[];
}

const { site, posts, title, heading, accent, intro, description, links } = Astro.props;
const [first, ...rest] = posts;
---

<Layout site={site} title={title} description={description} links={links}>
  <slot name="cta" slot="cta" />
  <link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" slot="head" />

  <section class="relative overflow-hidden border-b border-line">
    <div class="graph-paper pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 pb-14 pt-14 sm:px-6 sm:pt-20">
      <p class="eyebrow">Blog</p>
      <h1 class="mt-4 max-w-3xl text-5xl font-semibold sm:text-6xl">
        {heading} <span class="accent-word">{accent}</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">{intro}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    {posts.length === 0 && <p class="text-muted">The first posts are on their way.</p>}
    {first && (
      <PostCard
        featured
        href={`/blog/${first.id}/`}
        title={first.data.title}
        description={first.data.description}
        date={first.data.pubDate}
        minutes={readingMinutes(first.body)}
        tags={first.data.tags}
        cover={first.data.cover}
        coverAlt={first.data.coverAlt}
      />
    )}
    {rest.length > 0 && (
      <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((p) => (
          <PostCard
            href={`/blog/${p.id}/`}
            title={p.data.title}
            description={p.data.description}
            date={p.data.pubDate}
            minutes={readingMinutes(p.body)}
            tags={p.data.tags}
            cover={p.data.cover}
            coverAlt={p.data.coverAlt}
          />
        ))}
      </div>
    )}
  </section>
</Layout>
