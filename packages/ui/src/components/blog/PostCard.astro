---
import { formatDate } from "../../blog/schema";

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  minutes: number;
  tags: string[];
  cover?: string;
  coverAlt?: string;
  featured?: boolean;
}

const { href, title, description, date, minutes, tags, cover, coverAlt, featured = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    "group flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-bg transition-transform duration-300 hover:-translate-y-1",
    featured && "md:grid md:grid-cols-[1.1fr_1fr]",
  ]}
>
  <div class:list={["relative overflow-hidden bg-surface", featured ? "aspect-[16/10] md:aspect-auto md:min-h-[320px]" : "aspect-[16/9]"]}>
    {cover ? (
      <img src={cover} alt={coverAlt ?? ""} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
    ) : (
      <div class="graph-paper absolute inset-0" aria-hidden="true"></div>
      <!-- Typographic cover for posts without an image -->
      <div class="relative flex h-full flex-col justify-between gap-6 p-6" aria-hidden="true">
        <div class="flex items-start justify-between gap-4">
          <span class="w-fit rounded-full border border-line bg-bg px-3 py-1 font-mono text-xs">Guide</span>
          <div class="flex h-16 items-end gap-1.5">
            {[40, 65, 50, 85, 100].map((h, i) => (
              <span class="w-3 rounded-t-sm" style={`height:${h}%;background:${i === 4 ? "var(--accent)" : "color-mix(in oklab, var(--accent) 35%, transparent)"}`}></span>
            ))}
          </div>
        </div>
        <p class:list={["font-serif italic leading-none text-accent", featured ? "text-6xl sm:text-7xl" : "text-5xl"]}>{tags[0] ?? "Guide"}</p>
      </div>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-3 p-6">
    <p class="font-mono text-xs text-muted">{formatDate(date)} · {minutes} min read</p>
    <h3 class:list={["font-semibold leading-tight group-hover:text-accent", featured ? "text-3xl" : "text-xl"]}>{title}</h3>
    <p class="text-[15px] text-muted">{description}</p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-2">
      {tags.slice(0, 3).map((t) => <li class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs">{t}</li>)}
    </ul>
  </div>
</a>
